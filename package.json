    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  },
  "engines": {
    "node": ">=22"
